  "uses": {
    "one": {"ru": "Один из многих", "rule": "Исчисляемое, одно из многих, впервые или «какой-нибудь» — un (м.), une (ж.). J'ai un chien. C'est une pomme. Il y a un parc ici.", "level": 1},
    "known": {"ru": "Тот самый", "rule": "Предмет известен обоим, единственный или уточнён (чей, какой) — le (м.), la (ж.). Ferme la porte. C'est la voiture de Marie.", "level": 2},
    "forms": {"ru": "Формы: l', les", "level": 3, "rule": "Тот самый перед гласной или немой h — l' (оба рода): l'hôtel, l'école. Несколько тех самых — les (оба рода): les clés, les enfants."},
    "first": {"ru": "Впервые → тот самый", "level": 4, "rule": "Предмет появился впервые — un, une; дальше о нём же — le, la, l'. J'ai un chat. Le chat mange du poisson."},
    "many": {"ru": "des или les", "level": 5, "rule": "Несколько каких-то, впервые — des; те самые, известные — les. Il y a des enfants dans le jardin. Les enfants de Sophie jouent. По-русски артикля нет ни там, ни там."},
    "general": {"ru": "Вообще", "rule": "После aimer, adorer, détester речь о вещи вообще — определённый: j'aime le café, je déteste les chats. Даже если по-русски «люблю кофе» без всякого «этот».", "level": 6},
    "some": {"ru": "Сколько-то", "rule": "Несчитаемое в неизвестном количестве — еда, питьё, вещество, погода — частичный: du, de la, de l'. Je mange du pain. Il y a du vent. По-русски артикля нет, по-французски он обязателен.", "level": 7},
    "pair": {"ru": "Люблю le, ем du", "level": 8, "rule": "Решает глагол: aimer, adorer, détester — вещь вообще → le, la; manger, prendre, cuisiner, il y a — сколько-то → du, de la, de l'. J'aime le café — je prends du café."},
    "neg": {"ru": "После отрицания", "rule": "После ne … pas артикли un, une, des, du, de la, de l' превращаются в de, перед гласной d': je n'ai pas de voiture, il n'y a pas d'eau.", "level": 9},
    "neg_def": {"ru": "Отрицание и le", "rule": "Определённый артикль отрицание не трогает: je n'aime pas le café, il ne ferme pas la porte. В de превращаются только un, une, des и частичный.", "level": 9},
    "etre": {"ru": "Ce n'est pas", "rule": "Исключение — être: после ce n'est pas артикль остаётся, de не нужен. Ce n'est pas un chien. Ce n'est pas du sucre.", "level": 10},
    "amount": {"ru": "Сколько именно", "rule": "После слов количества — голое de, без артикля: beaucoup de pain, un litre de lait, beaucoup d'amis.", "level": 10}
  },
